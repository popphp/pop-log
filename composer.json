{
    "name": "popphp/pop-log",
    "description": "Pop Log Component for Pop PHP Framework",
    "keywords": [
        "log",
        "syslog",
        "logging",
        "php",
        "pop",
        "pop php"
    ],
    "homepage": "https://github.com/popphp/pop-log",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona",
            "email": "dev@noladev.com",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0",
        "popphp/pop-db": "^7.0.0-beta.1",
        "popphp/pop-http": "^6.0.0-beta.4",
        "popphp/pop-mail": "^5.0.0-beta.1"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Log\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Log\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.0.x-dev"
        }
    }
}
