{
    "name": "popphp/pop-log",
    "description": "Pop Log Component for Pop PHP Framework",
    "keywords": [
        "log",
        "syslog",
        "logging",
        "php",
        "pop",
        "pop php"
    ],
    "homepage": "https://github.com/popphp/pop-log",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona",
            "email": "dev@noladev.com",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0",
        "phpstan/phpstan": "^2.2",
        "popphp/pop-db": "^7.0.0",
        "popphp/pop-http": "^6.0.0",
        "popphp/pop-mail": "^5.0.0"
    },
    "suggest": {
        "popphp/pop-db": "For using the Database writer (^7.0.0)",
        "popphp/pop-http": "For using the Http writer (^6.0.0)",
        "popphp/pop-mail": "For using the Mail writer (^5.0.0)"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Log\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Log\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.0.x-dev"
        }
    }
}
